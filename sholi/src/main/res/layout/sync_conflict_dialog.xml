<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sync_conflict_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/sync_conflict_diagnostic_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:paddingBottom="8dp"
        android:scrollHorizontally="false"
        android:singleLine="false"
        android:text="@string/sync_conflict_diagnostic_label"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_conflict_choose_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="@string/sync_conflict_choose_hint" />

    <ScrollView
        android:id="@+id/sync_conflict_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/sync_conflict_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
